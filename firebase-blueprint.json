{
  "entities": {
    "PrinterConfig": {
      "title": "PrinterConfig",
      "description": "Configuration for a single printer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "connectionType": { "type": "string", "enum": ["printnode", "qz-tray", "browser"] },
        "targetPrinterName": { "type": "string" },
        "associatedCategories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "isEnabled": { "type": "boolean" },
        "status": { "type": "string" }
      },
      "required": ["id", "role", "name", "connectionType", "targetPrinterName"]
    },
    "PrintJob": {
      "title": "PrintJob",
      "description": "A queued print job",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "printerRole": { "type": "string" },
        "printerName": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "failed"] },
        "errorDetail": { "type": "string" },
        "timestamp": { "type": "string" },
        "retryCount": { "type": "number" }
      },
      "required": ["id", "printerRole", "printerName", "title", "content", "status", "timestamp", "retryCount"]
    }
  },
  "firestore": {
    "/restaurants/{restaurantId}/printers/{printerId}": {
      "schema": { "$ref": "#/entities/PrinterConfig" },
      "description": "Printers configured for the restaurant."
    },
    "/restaurants/{restaurantId}/printJobs/{jobId}": {
      "schema": { "$ref": "#/entities/PrintJob" },
      "description": "Print jobs queued for the restaurant."
    }
  }
}
