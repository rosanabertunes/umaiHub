rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPrinterConfig(data) {
      return data.keys().hasAll(['id', 'role', 'name', 'connectionType', 'targetPrinterName'])
        && data.id is string && data.id.size() <= 128
        && data.role is string && data.role.size() <= 50
        && data.name is string && data.name.size() <= 100
        && data.connectionType in ['printnode', 'qz-tray', 'browser']
        && data.targetPrinterName is string && data.targetPrinterName.size() <= 100
        && (!('isEnabled' in data) || data.isEnabled is bool)
        && (!('status' in data) || (data.status is string && data.status.size() <= 100));
    }

    function isValidPrintJob(data) {
      return data.keys().hasAll(['id', 'printerRole', 'printerName', 'title', 'content', 'status', 'timestamp', 'retryCount'])
        && data.id is string && data.id.size() <= 128
        && data.printerRole is string && data.printerRole.size() <= 128
        && data.printerName is string && data.printerName.size() <= 100
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 500000
        && data.status in ['pending', 'processing', 'completed', 'failed']
        && data.timestamp is string && data.timestamp.size() <= 50
        && data.retryCount is number
        && (!('errorDetail' in data) || (data.errorDetail is string && data.errorDetail.size() <= 1000));
    }

    match /restaurants/{restaurantId} {
      allow read, write: if isSignedIn();

      match /printers/{printerId} {
        allow read, write: if true;
      }
      
      match /printJobs/{jobId} {
        allow read, write: if true;
      }

      match /receipts/{receiptId} {
        allow read, write: if true;
      }

      match /orders/{orderId} {
        allow read, write: if true;
      }
    }
  }
}
